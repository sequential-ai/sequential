{
  "name": "@sequential-ai/sdk",
  "version": "0.1.0",
  "description": "The official TypeScript and Node.js SDK for the Sequential AI API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "sequential",
    "ai",
    "sdk",
    "api"
  ],
  "author": "Sequential AI",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.11.18",
    "tsup": "^8.0.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
