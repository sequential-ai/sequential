{
  "info": {
    "name": "Sequential AI Task API v2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Task (No Spec)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Explain Server Components in React\",\n  \"mode\": \"FAST\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/tasks",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tasks"]
        }
      }
    },
    {
      "name": "Create Task (With taskSpec)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Top 3 features of React 19\",\n  \"mode\": \"FAST\",\n  \"taskSpec\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"answer\": { \"type\": \"string\" },\n      \"features\": {\n        \"type\": \"array\",\n        \"items\": { \"type\": \"string\" }\n      }\n    }\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/tasks",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tasks"]
        }
      }
    },
    {
      "name": "Get Task Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tasks/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tasks", ":id"],
          "variable": [
            { "key": "id", "value": "TASK_ID_HERE" }
          ]
        }
      }
    }
  ]
}
