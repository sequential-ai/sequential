PORT=5000
SERPER_API_KEY=
SERPER_API_URL=https://google.serper.dev/search

# -------------------------
# Billing & Pricing
# -------------------------
BILLING_PRICING_MODE=markup
BILLING_MARKUP_PERCENT=40
BILLING_MARGIN_PERCENT=0
BILLING_MINIMUM_TASK_COST_USD=0.01

